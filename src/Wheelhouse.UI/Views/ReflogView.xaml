<UserControl x:Class="Wheelhouse.UI.Views.ReflogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Wheelhouse.UI.ViewModels"
             d:DataContext="{d:DesignInstance vm:ReflogViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource BrushBackground}">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BrushSurfaceAlt}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
                <TextBlock Text="REFLOG" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushOnSurfaceMuted}" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding LoadCommand}"
                        Padding="6,2" FontSize="11" Background="Transparent"
                        Foreground="{DynamicResource BrushOnSurfaceMuted}"
                        BorderThickness="1" BorderBrush="{DynamicResource BrushBorder}" />
            </DockPanel>
        </Border>

        <TextBlock Text="Loading..." DockPanel.Dock="Top" Margin="8,4"
                   Foreground="{DynamicResource BrushOnSurfaceMuted}" FontSize="12"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

        <ListView ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedEntry}"
                  Background="{DynamicResource BrushSurface}"
                  BorderThickness="0"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Height" Value="26" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Checkout" Command="{Binding CheckoutCommand}" />
                                <MenuItem Header="Reset to Here..." Command="{Binding ResetToCommand}" />
                                <MenuItem Header="Cherry-pick" Command="{Binding CherryPickCommand}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="SHA" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:ReflogEntryViewModel}">
                                <TextBlock Text="{Binding ShortSha}" FontFamily="{StaticResource FontMono}"
                                           FontSize="11" Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Ref" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:ReflogEntryViewModel}">
                                <TextBlock Text="{Binding RefName}" FontFamily="{StaticResource FontMono}"
                                           FontSize="11" Foreground="{DynamicResource BrushPrimary}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Action" Width="400">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:ReflogEntryViewModel}">
                                <TextBlock Text="{Binding Message}" FontSize="12"
                                           Foreground="{DynamicResource BrushOnSurface}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="When" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:ReflogEntryViewModel}">
                                <TextBlock Text="{Binding RelativeDate}" FontSize="12"
                                           Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
