<Window x:Class="Wheelhouse.UI.Views.AccountSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account Settings"
        Height="360" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Close" IsCancel="True" IsDefault="True" Padding="14,6"
                    Background="Transparent" BorderThickness="1" />
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Hosting Accounts" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16" />
            <ItemsControl x:Name="ProvidersPanel" />
        </StackPanel>
    </DockPanel>
</Window>
