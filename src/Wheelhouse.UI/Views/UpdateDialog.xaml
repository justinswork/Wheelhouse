<Window x:Class="Wheelhouse.UI.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prop="clr-namespace:Wheelhouse.UI.Properties"
        Title="{x:Static prop:Strings.Update_DialogTitle}"
        Height="440" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushBackground}">
    <DockPanel Margin="16">

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="LaterButton"
                    Content="{x:Static prop:Strings.Update_Later}"
                    IsCancel="True"
                    Padding="14,6" Margin="0,0,8,0"
                    Background="Transparent" BorderThickness="1"
                    Click="OnLaterClick" />
            <Button x:Name="UpdateNowButton"
                    Content="{x:Static prop:Strings.Update_Now}"
                    IsDefault="True"
                    Padding="14,6" FontWeight="SemiBold"
                    Click="OnUpdateNowClick" />
        </StackPanel>

        <StackPanel>
            <!-- Header -->
            <TextBlock x:Name="HeaderText"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushOnSurface}"
                       Margin="0,0,0,12" />

            <!-- Release notes -->
            <TextBlock Text="Release notes:"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushOnSurfaceMuted}"
                       Margin="0,0,0,6" />
            <ScrollViewer Height="280"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          BorderBrush="{DynamicResource BrushBorder}"
                          BorderThickness="1">
                <TextBox x:Name="ReleaseNotesBox"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8"
                         FontSize="12"
                         Foreground="{DynamicResource BrushOnSurface}"
                         FontFamily="{StaticResource FontMono}" />
            </ScrollViewer>
        </StackPanel>
    </DockPanel>
</Window>
