<UserControl x:Class="Wheelhouse.UI.Views.BlameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Wheelhouse.UI.ViewModels"
             d:DataContext="{d:DesignInstance vm:BlameViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource BrushBackground}">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BrushSurfaceAlt}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
                <TextBlock Text="BLAME" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushOnSurfaceMuted}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding FilePath}" FontSize="11" Margin="8,0,0,0"
                           FontFamily="{StaticResource FontMono}"
                           Foreground="{DynamicResource BrushOnSurfaceMuted}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <TextBlock Text="Loading blame..." DockPanel.Dock="Top" Margin="8,4"
                   Foreground="{DynamicResource BrushOnSurfaceMuted}" FontSize="12"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Lines}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BlameLineViewModel}">
                        <Border Background="{Binding AgeBrush}" BorderThickness="0,0,0,0">
                            <DockPanel>
                                <!-- Blame annotation (left side) -->
                                <Border DockPanel.Dock="Left" Width="230"
                                        Background="{DynamicResource BrushSurfaceAlt}"
                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                        BorderThickness="0,0,1,0" Padding="4,1">
                                    <DockPanel>
                                        <TextBlock Text="{Binding RelativeDate}" DockPanel.Dock="Right"
                                                   FontSize="10" Width="60"
                                                   Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                                   TextAlignment="Right" VerticalAlignment="Center" />
                                        <Button Content="{Binding ShortSha}"
                                                Command="{Binding NavigateToCommitCommand}"
                                                FontFamily="{StaticResource FontMono}" FontSize="11"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource BrushPrimary}"
                                                Cursor="Hand" Padding="0" Margin="0,0,6,0"
                                                Width="56" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding AuthorName}" FontSize="11"
                                                   Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <!-- Line number -->
                                <TextBlock Text="{Binding LineNumber}" DockPanel.Dock="Left"
                                           Width="44" TextAlignment="Right" Padding="0,1,6,1"
                                           FontFamily="{StaticResource FontMono}" FontSize="11"
                                           Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                           Background="{DynamicResource BrushSurfaceAlt}" />
                                <!-- Line content -->
                                <TextBlock Text="{Binding Content}"
                                           FontFamily="{StaticResource FontMono}" FontSize="12"
                                           Foreground="{DynamicResource BrushOnSurface}"
                                           Padding="8,1" TextWrapping="NoWrap" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
