<UserControl x:Class="Wheelhouse.UI.Views.RepositorySidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Wheelhouse.UI.ViewModels"
             xmlns:prop="clr-namespace:Wheelhouse.UI.Properties"
             d:DataContext="{d:DesignInstance vm:RepositorySidebarViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource BrushSidebarBg}">
    <DockPanel>

        <!-- Repo name header -->
        <Border DockPanel.Dock="Top"
                Padding="8,6"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="{Binding RepositoryName}"
                           FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource BrushOnSurface}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CurrentBranchName}"
                           FontSize="11"
                           Foreground="{DynamicResource BrushPrimary}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Empty state -->
        <TextBlock Text="{x:Static prop:Strings.Sidebar_EmptyState}"
                   Foreground="{DynamicResource BrushOnSurfaceMuted}"
                   TextWrapping="Wrap"
                   Margin="8,8"
                   FontSize="12"
                   Visibility="{Binding HasRepository, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

        <!-- Branch/stash/tag/remote tree -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Reflog shortcut -->
                <Border Padding="8,4" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1"
                        Visibility="{Binding HasRepository, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Content="{x:Static prop:Strings.Sidebar_ViewReflog}"
                            Command="{Binding OpenReflogCommand}"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource BrushPrimary}"
                            FontSize="12" HorizontalAlignment="Left" Padding="0"
                            Cursor="Hand" />
                </Border>

                <!-- Local Branches -->
                <Expander IsExpanded="True" Margin="0,4,0,0">
                    <Expander.Header>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="+" Padding="4,0" FontSize="13"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                    Command="{Binding DataContext.CreateBranchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="{x:Static prop:Strings.Sidebar_NewBranch_Tooltip}" />
                            <TextBlock Text="{x:Static prop:Strings.Sidebar_LocalBranches}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding LocalBranches}" Margin="8,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BranchItemViewModel}">
                                <Border Padding="4,3" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{x:Static prop:Strings.Branch_Checkout}" Command="{Binding CheckoutCommand}" />
                                            <MenuItem Header="{x:Static prop:Strings.Branch_MergeIntoCurrent}" Command="{Binding MergeIntoCurrentCommand}" />
                                            <MenuItem Header="{x:Static prop:Strings.Branch_RebaseOnto}" Command="{Binding RebaseOntoCommand}" />
                                            <Separator />
                                            <MenuItem Header="{x:Static prop:Strings.Branch_Rename}" Command="{Binding RenameCommand}" />
                                            <MenuItem Header="{x:Static prop:Strings.Branch_Delete}" Command="{Binding DeleteCommand}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="⎇ " FontSize="11"
                                                   Foreground="{DynamicResource BrushPrimary}"
                                                   Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding AheadBehind}" DockPanel.Dock="Right"
                                                   FontSize="10" Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushOnSurface}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding CheckoutCommand}" />
                                    </Border.InputBindings>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!-- Remote Branches -->
                <Expander IsExpanded="False" Margin="0,4,0,0">
                    <Expander.Header>
                        <TextBlock Text="{x:Static prop:Strings.Sidebar_RemoteBranches}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushOnSurfaceMuted}" />
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding RemoteBranches}" Margin="8,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BranchItemViewModel}">
                                <Border Padding="4,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{x:Static prop:Strings.Branch_Checkout}" Command="{Binding CheckoutCommand}" />
                                            <Separator />
                                            <MenuItem Header="{x:Static prop:Strings.Branch_DeleteRemote}" Command="{Binding DeleteRemoteBranchCommand}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                               Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!-- Tags -->
                <Expander IsExpanded="False" Margin="0,4,0,0"
                          Visibility="{Binding HasRepository, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Expander.Header>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="+" Padding="4,0" FontSize="13"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                    Command="{Binding DataContext.CreateTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="{x:Static prop:Strings.Sidebar_NewTag_Tooltip}" />
                            <TextBlock Text="{x:Static prop:Strings.Sidebar_Tags}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Tags}" Margin="8,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TagItemViewModel}">
                                <Border Padding="4,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{x:Static prop:Strings.Tag_Push}" Command="{Binding PushCommand}" />
                                            <Separator />
                                            <MenuItem Header="{x:Static prop:Strings.Tag_Delete}" Command="{Binding DeleteCommand}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <DockPanel>
                                        <TextBlock Text="{Binding RelativeDate}" DockPanel.Dock="Right"
                                                   FontSize="10" Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                   Foreground="{DynamicResource BrushOnSurface}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!-- Remotes -->
                <Expander IsExpanded="False" Margin="0,4,0,0"
                          Visibility="{Binding HasRepository, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Expander.Header>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="+" Padding="4,0" FontSize="13"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                    Command="{Binding DataContext.AddRemoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="{x:Static prop:Strings.Sidebar_AddRemote_Tooltip}" />
                            <TextBlock Text="{x:Static prop:Strings.Sidebar_Remotes}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Remotes}" Margin="8,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RemoteItemViewModel}">
                                <Border Padding="4,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{x:Static prop:Strings.Remote_Fetch}" Command="{Binding FetchCommand}" />
                                            <MenuItem Header="{x:Static prop:Strings.Remote_Prune}" Command="{Binding PruneCommand}" />
                                            <Separator />
                                            <MenuItem Header="{x:Static prop:Strings.Remote_Rename}" Command="{Binding RenameCommand}" />
                                            <MenuItem Header="{x:Static prop:Strings.Remote_Remove}" Command="{Binding RemoveCommand}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <DockPanel>
                                        <TextBlock Text="{Binding Url}" DockPanel.Dock="Bottom"
                                                   FontSize="10" Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushOnSurface}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!-- Stashes -->
                <Expander IsExpanded="True" Margin="0,4,0,0"
                          Visibility="{Binding HasStashes, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Expander.Header>
                        <TextBlock Text="{x:Static prop:Strings.Sidebar_Stashes}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushOnSurfaceMuted}" />
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Stashes}" Margin="8,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StashItemViewModel}">
                                <Border Padding="4,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{x:Static prop:Strings.Stash_Apply}" Command="{Binding ApplyCommand}" />
                                            <MenuItem Header="{x:Static prop:Strings.Stash_PopApply}" Command="{Binding PopCommand}" />
                                            <Separator />
                                            <MenuItem Header="{x:Static prop:Strings.Stash_Drop}" Command="{Binding DropCommand}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <DockPanel>
                                        <TextBlock Text="{Binding RelativeDate}" DockPanel.Dock="Right"
                                                   FontSize="10" Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                                        <TextBlock Text="{Binding Message}" FontSize="12"
                                                   Foreground="{DynamicResource BrushOnSurface}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!-- Worktrees -->
                <Expander IsExpanded="False" Margin="0,4,0,0"
                          Visibility="{Binding HasWorktrees, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Expander.Header>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Prune" Padding="4,0" FontSize="11"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                        Command="{Binding DataContext.PruneWorktreesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="{x:Static prop:Strings.Sidebar_PruneWorktrees_Tooltip}" />
                                <Button Content="+" Padding="4,0" FontSize="13"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                        Command="{Binding DataContext.AddWorktreeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="{x:Static prop:Strings.Sidebar_AddWorktree_Tooltip}" />
                            </StackPanel>
                            <TextBlock Text="{x:Static prop:Strings.Sidebar_Worktrees}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Worktrees}" Margin="8,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WorktreeItemViewModel}">
                                <Border Padding="4,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{x:Static prop:Strings.Worktree_Remove}" Command="{Binding RemoveCommand}"
                                                      IsEnabled="{Binding CanRemove}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <DockPanel>
                                        <TextBlock Text="{Binding Branch}" DockPanel.Dock="Bottom"
                                                   FontSize="10" Foreground="{DynamicResource BrushPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DisplayPath}" FontSize="12"
                                                   Foreground="{DynamicResource BrushOnSurface}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
