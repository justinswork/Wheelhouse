<Window x:Class="Wheelhouse.UI.Views.CreateBranchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Branch"
        Height="170" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="14,6" Margin="0,0,8,0"
                    Background="Transparent" BorderThickness="1" />
            <Button x:Name="CreateButton" Content="Create" IsDefault="True" Padding="14,6"
                    Click="OnCreateClick" />
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Branch name:" FontSize="12" Margin="0,0,0,4" />
            <TextBox x:Name="BranchNameBox" FontSize="12" Padding="4"
                     TextChanged="OnBranchNameChanged" />
            <CheckBox x:Name="CheckoutCheckBox" Content="Checkout immediately" IsChecked="True"
                      Margin="0,10,0,0" FontSize="12" />
        </StackPanel>
    </DockPanel>
</Window>
