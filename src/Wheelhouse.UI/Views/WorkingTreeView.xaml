<UserControl x:Class="Wheelhouse.UI.Views.WorkingTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Wheelhouse.UI.ViewModels"
             xmlns:prop="clr-namespace:Wheelhouse.UI.Properties"
             d:DataContext="{d:DesignInstance vm:WorkingTreeViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource BrushBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Error banner (only visible when ErrorMessage is set) -->
        <Border Grid.Row="0"
                Background="#FFEBE9" BorderBrush="#FFCFC9" BorderThickness="0,0,0,1"
                Padding="8,6"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{x:Static prop:Strings.WorkingTree_Retry}" Padding="6,2" FontSize="11"
                        Command="{Binding RefreshCommand}"
                        Background="Transparent" BorderThickness="1" BorderBrush="#FFCFC9" />
                <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#CF222E"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Staged Changes -->
        <DockPanel Grid.Row="1">
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource BrushSurfaceAlt}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Padding="8,4">
                <DockPanel>
                    <TextBlock Text="{x:Static prop:Strings.WorkingTree_Staged}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushOnSurfaceMuted}" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="↺" Padding="6,2" FontSize="11"
                                Command="{Binding RefreshCommand}"
                                Background="Transparent" Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                BorderThickness="0" ToolTip="{x:Static prop:Strings.WorkingTree_Refresh_Tooltip}" />
                        <Button Content="{x:Static prop:Strings.WorkingTree_UnstageAll}" Padding="6,2" FontSize="11"
                                Command="{Binding UnstageAllCommand}"
                                Background="Transparent" Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                BorderThickness="1" BorderBrush="{DynamicResource BrushBorder}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Background="{DynamicResource BrushSurface}">
                <ListView ItemsSource="{Binding StagedFiles}"
                          SelectedItem="{Binding SelectedStagedFile}"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FileStatusItemViewModel}">
                            <Grid Margin="4,2">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{x:Static prop:Strings.WorkingTree_EditInIndex}" Command="{Binding OpenIndexEditorCommand}" />
                                        <Separator />
                                        <MenuItem Header="{x:Static prop:Strings.Branch_FileHistory}" Command="{Binding OpenFileHistoryCommand}" />
                                        <MenuItem Header="{x:Static prop:Strings.Branch_Blame}" Command="{Binding OpenBlameCommand}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding StateLabel}"
                                           Foreground="{DynamicResource BrushOnSurface}"
                                           FontFamily="{StaticResource FontMono}" FontSize="11"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding FilePath}"
                                           Foreground="{DynamicResource BrushOnSurface}"
                                           FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2" Content="−" Padding="4,1" FontSize="11"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                        Command="{Binding DataContext.UnstageFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{x:Static prop:Strings.WorkingTree_Unstage_Tooltip}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="{x:Static prop:Strings.WorkingTree_NoStaged}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource BrushOnSurfaceMuted}"
                           Visibility="{Binding HasNoStagedFiles, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </DockPanel>

        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                      Background="{DynamicResource BrushBorderSubtle}" />

        <!-- Unstaged Changes -->
        <DockPanel Grid.Row="3">
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource BrushSurfaceAlt}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Padding="8,4">
                <DockPanel>
                    <TextBlock Text="{x:Static prop:Strings.WorkingTree_Unstaged}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushOnSurfaceMuted}" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{x:Static prop:Strings.WorkingTree_StageAll}" Padding="6,2" FontSize="11"
                                Command="{Binding StageAllCommand}"
                                Background="Transparent" Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                BorderThickness="1" BorderBrush="{DynamicResource BrushBorder}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Background="{DynamicResource BrushSurface}">
                <ListView ItemsSource="{Binding UnstagedFiles}"
                          SelectedItem="{Binding SelectedUnstagedFile}"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FileStatusItemViewModel}">
                            <Grid Margin="4,2">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{x:Static prop:Strings.WorkingTree_EditInIndex}" Command="{Binding OpenIndexEditorCommand}" />
                                        <Separator />
                                        <MenuItem Header="{x:Static prop:Strings.Branch_FileHistory}" Command="{Binding OpenFileHistoryCommand}" />
                                        <MenuItem Header="{x:Static prop:Strings.Branch_Blame}" Command="{Binding OpenBlameCommand}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding StateLabel}"
                                           Foreground="{DynamicResource BrushOnSurface}"
                                           FontFamily="{StaticResource FontMono}" FontSize="11"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding FilePath}"
                                           Foreground="{DynamicResource BrushOnSurface}"
                                           FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2" Content="+" Padding="4,1" FontSize="11"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                        Command="{Binding DataContext.StageFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{x:Static prop:Strings.WorkingTree_Stage_Tooltip}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="{x:Static prop:Strings.WorkingTree_NoUnstaged}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource BrushOnSurfaceMuted}"
                           Visibility="{Binding HasNoUnstagedFiles, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </DockPanel>

        <!-- Commit Area -->
        <Border Grid.Row="4"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="8">
            <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <CheckBox DockPanel.Dock="Left" Content="{x:Static prop:Strings.WorkingTree_Amend}" IsChecked="{Binding Amend}"
                              Foreground="{DynamicResource BrushOnSurfaceMuted}" FontSize="12"
                              VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button DockPanel.Dock="Right" Content="{x:Static prop:Strings.WorkingTree_Commit}"
                            Command="{Binding CommitCommand}"
                            IsEnabled="{Binding CanCommit}"
                            Padding="16,6" FontWeight="SemiBold" />
                </DockPanel>
                <TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="60" MaxHeight="120"
                         Background="{DynamicResource BrushSurface}"
                         Foreground="{DynamicResource BrushOnSurface}"
                         BorderBrush="{DynamicResource BrushBorder}"
                         FontSize="12"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Resources>
                                <VisualBrush x:Key="HintBrush" TileMode="None" Opacity="0.4" Stretch="None" AlignmentX="Left" AlignmentY="Top">
                                    <VisualBrush.Visual>
                                        <TextBlock Text="{x:Static prop:Strings.WorkingTree_CommitPlaceholder}" FontSize="12" Margin="4,4" />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource HintBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
