<UserControl x:Class="Wheelhouse.UI.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:vm="clr-namespace:Wheelhouse.UI.ViewModels"
             d:DataContext="{d:DesignInstance vm:DiffViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource BrushBackground}">
    <DockPanel>
        <!-- Diff header bar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BrushSurfaceAlt}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <TextBlock Text="{Binding DiffHeader}"
                       FontFamily="{StaticResource FontMono}"
                       FontSize="12"
                       Foreground="{DynamicResource BrushOnSurface}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Loading indicator -->
        <TextBlock DockPanel.Dock="Top"
                   Text="Loading diff..."
                   Foreground="{DynamicResource BrushOnSurfaceMuted}"
                   Margin="8,4"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- Empty state -->
        <TextBlock Text="Select a file to view its diff."
                   Foreground="{DynamicResource BrushOnSurfaceMuted}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- AvalonEdit diff viewer -->
        <avalon:TextEditor x:Name="DiffEditor"
                           IsReadOnly="True"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="12"
                           Background="{DynamicResource BrushSurface}"
                           Foreground="{DynamicResource BrushOnSurface}"
                           BorderThickness="0"
                           ShowLineNumbers="True"
                           WordWrap="False"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</UserControl>
