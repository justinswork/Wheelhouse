<UserControl x:Class="Wheelhouse.UI.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Wheelhouse.UI.ViewModels"
             d:DataContext="{d:DesignInstance vm:DiffViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource BrushBackground}">
    <DockPanel>

        <!-- Diff header bar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BrushSurfaceAlt}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <TextBlock Text="{Binding DiffHeader}"
                       FontFamily="{StaticResource FontMono}"
                       FontSize="12"
                       Foreground="{DynamicResource BrushOnSurface}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Loading indicator -->
        <TextBlock DockPanel.Dock="Top"
                   Text="Loading diff..."
                   Foreground="{DynamicResource BrushOnSurfaceMuted}"
                   Margin="8,4"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- Empty state -->
        <TextBlock Text="Select a file to view its diff."
                   Foreground="{DynamicResource BrushOnSurfaceMuted}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- Binary indicator -->
        <TextBlock Text="Binary file — diff not shown"
                   Foreground="{DynamicResource BrushOnSurfaceMuted}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding IsBinary, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- Hunk list -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Hunks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HunkViewModel}">
                        <StackPanel Margin="0,4,0,0">

                            <!-- Hunk header toolbar -->
                            <Border Background="#1E3A5C" Padding="4,3">
                                <DockPanel>
                                    <!-- Unstage Hunk -->
                                    <Button DockPanel.Dock="Right"
                                            Content="Unstage Hunk"
                                            Command="{Binding UnstageHunkCommand}"
                                            Padding="6,2" FontSize="11"
                                            Background="#2D6A9F"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Margin="4,0,0,0"
                                            Visibility="{Binding CanUnstage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <!-- Discard Hunk -->
                                    <Button DockPanel.Dock="Right"
                                            Content="Discard Hunk"
                                            Command="{Binding DiscardHunkCommand}"
                                            Padding="6,2" FontSize="11"
                                            Background="#7B2D2D"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Margin="4,0,0,0"
                                            Visibility="{Binding CanDiscard, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <!-- Stage Hunk -->
                                    <Button DockPanel.Dock="Right"
                                            Content="Stage Hunk"
                                            Command="{Binding StageHunkCommand}"
                                            Padding="6,2" FontSize="11"
                                            Background="#1A5E3C"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Margin="4,0,0,0"
                                            Visibility="{Binding CanStage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding Header}"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="11"
                                               Foreground="#7BC8F0"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <!-- Diff lines -->
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DiffLineViewModel}">
                                        <Border Background="{Binding Background}">
                                            <DockPanel>
                                                <!-- Old line number -->
                                                <TextBlock Text="{Binding OldLineNo}"
                                                           Width="36"
                                                           FontFamily="{StaticResource FontMono}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                                           TextAlignment="Right"
                                                           Padding="0,0,4,0" />
                                                <!-- New line number -->
                                                <TextBlock Text="{Binding NewLineNo}"
                                                           Width="36"
                                                           FontFamily="{StaticResource FontMono}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                                           TextAlignment="Right"
                                                           Padding="0,0,6,0" />
                                                <!-- +/- prefix -->
                                                <TextBlock Text="{Binding Prefix}"
                                                           Width="12"
                                                           FontFamily="{StaticResource FontMono}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource BrushOnSurface}" />
                                                <!-- Line content -->
                                                <TextBlock Text="{Binding Content}"
                                                           FontFamily="{StaticResource FontMono}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource BrushOnSurface}"
                                                           TextWrapping="NoWrap" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</UserControl>
