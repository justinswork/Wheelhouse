<UserControl x:Class="Wheelhouse.UI.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Wheelhouse.UI.ViewModels"
             xmlns:graph="clr-namespace:Wheelhouse.UI.Controls.CommitGraph"
             d:DataContext="{d:DesignInstance vm:LogViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource BrushBackground}">
    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BrushSurfaceAlt}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <DockPanel>
                <TextBlock Text="LOG" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushOnSurfaceMuted}"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Refresh"
                        Command="{Binding LoadCommand}"
                        Padding="6,2" FontSize="11"
                        Background="Transparent"
                        Foreground="{DynamicResource BrushOnSurfaceMuted}"
                        BorderThickness="1" BorderBrush="{DynamicResource BrushBorder}" />
            </DockPanel>
        </Border>

        <!-- Load more -->
        <Button DockPanel.Dock="Bottom"
                Content="Load more commits..."
                Command="{Binding LoadMoreCommand}"
                Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{DynamicResource BrushSurface}"
                Foreground="{DynamicResource BrushOnSurfaceMuted}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                Padding="8,6" />

        <!-- Commit list
             Tag on each ListViewItem is set to the LogViewModel so that ContextMenu commands
             can bind to it via PlacementTarget.Tag while CommandParameter binds to the item VM. -->
        <ListView x:Name="CommitList"
                  ItemsSource="{Binding Commits}"
                  SelectedItem="{Binding SelectedCommit}"
                  Background="{DynamicResource BrushSurface}"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Height" Value="24" />
                    <Setter Property="Tag" Value="{Binding ElementName=CommitList, Path=DataContext}" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Cherry-pick"
                                          Command="{Binding PlacementTarget.Tag.CherryPickCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Revert Commit..."
                                          Command="{Binding PlacementTarget.Tag.RevertCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Reset to Here..."
                                          Command="{Binding PlacementTarget.Tag.ResetToHereCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:CommitItemViewModel}">
                                <graph:CommitGraphPanel Row="{Binding GraphRow}" RowHeight="24" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Message" Width="400">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:CommitItemViewModel}">
                                <TextBlock Text="{Binding MessageShort}"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushOnSurface}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Author" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:CommitItemViewModel}">
                                <TextBlock Text="{Binding AuthorName}"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Date" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:CommitItemViewModel}">
                                <TextBlock Text="{Binding RelativeDate}"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="SHA" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:CommitItemViewModel}">
                                <TextBlock Text="{Binding ShortSha}"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
