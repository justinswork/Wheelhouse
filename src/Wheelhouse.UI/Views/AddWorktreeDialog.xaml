<Window x:Class="Wheelhouse.UI.Views.AddWorktreeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Worktree"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushBackground}">
    <StackPanel Margin="16">
        <TextBlock Text="Worktree path:" FontSize="12"
                   Foreground="{DynamicResource BrushOnSurface}" Margin="0,0,0,4" />
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,4" Margin="6,0,0,0"
                    FontSize="12" Click="OnBrowseClick" />
            <TextBox x:Name="PathBox" FontSize="12" Padding="4"
                     Background="{DynamicResource BrushSurface}"
                     Foreground="{DynamicResource BrushOnSurface}"
                     BorderBrush="{DynamicResource BrushBorder}" />
        </DockPanel>

        <TextBlock Text="Branch:" FontSize="12"
                   Foreground="{DynamicResource BrushOnSurface}" Margin="0,0,0,4" />
        <TextBox x:Name="BranchBox" FontSize="12" Padding="4" Margin="0,0,0,12"
                 Background="{DynamicResource BrushSurface}"
                 Foreground="{DynamicResource BrushOnSurface}"
                 BorderBrush="{DynamicResource BrushBorder}" />

        <CheckBox x:Name="CreateBranchCheck" Content="Create new branch" IsChecked="False"
                  FontSize="12" Foreground="{DynamicResource BrushOnSurface}" Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Height="30" Margin="0,0,8,0"
                    FontSize="12" IsCancel="True" Click="OnCancelClick" />
            <Button Content="Add" Width="80" Height="30"
                    FontSize="12" IsDefault="True" Click="OnAddClick" />
        </StackPanel>
    </StackPanel>
</Window>
