<Window x:Class="Wheelhouse.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Wheelhouse.UI.ViewModels"
        xmlns:views="clr-namespace:Wheelhouse.UI.Views"
        xmlns:prop="clr-namespace:Wheelhouse.UI.Properties"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="800" Width="1280"
        MinHeight="500" MinWidth="800"
        Background="{DynamicResource BrushBackground}">

    <!-- Implicit DataTemplates for tab content types -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:WorkingTreeViewModel}">
            <views:WorkingTreeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogViewModel}">
            <views:LogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReflogViewModel}">
            <views:ReflogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileHistoryViewModel}">
            <views:FileHistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BlameViewModel}">
            <views:BlameView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PullRequestsViewModel}">
            <views:PullRequestsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IndexEditorViewModel}">
            <views:IndexEditorView />
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="OemTilde" Modifiers="Ctrl" Command="{Binding ToggleTerminalCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenRepositoryCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- Menu -->
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource BrushSurface}"
              Foreground="{DynamicResource BrushOnSurface}">
            <MenuItem Header="{x:Static prop:Strings.Menu_File}">
                <MenuItem Header="{x:Static prop:Strings.Menu_File_Open}" Command="{Binding OpenRepositoryCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="{x:Static prop:Strings.Menu_File_Clone}" IsEnabled="False" />
                <MenuItem Header="{x:Static prop:Strings.Menu_File_Init}" IsEnabled="False" />
                <Separator />
                <MenuItem Header="{x:Static prop:Strings.Menu_File_Exit}" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="{x:Static prop:Strings.Menu_View}">
                <MenuItem Header="{x:Static prop:Strings.Menu_View_Terminal}" Command="{Binding ToggleTerminalCommand}"
                          IsCheckable="True" IsChecked="{Binding IsTerminalVisible}" InputGestureText="Ctrl+`" />
                <MenuItem Header="{x:Static prop:Strings.Menu_View_Reflog}" Command="{Binding OpenReflogCommand}" />
                <MenuItem Header="{x:Static prop:Strings.Menu_View_PullRequests}" Command="{Binding OpenPullRequestsCommand}" />
                <Separator />
                <MenuItem Header="{x:Static prop:Strings.Menu_View_Theme}">
                    <MenuItem Header="{x:Static prop:Strings.Menu_View_Theme_Light}"  Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                    <MenuItem Header="{x:Static prop:Strings.Menu_View_Theme_Dark}"   Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                    <MenuItem Header="{x:Static prop:Strings.Menu_View_Theme_System}" Command="{Binding SetThemeCommand}" CommandParameter="System" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{x:Static prop:Strings.Menu_Repository}">
                <MenuItem Header="{x:Static prop:Strings.Menu_Repository_Fetch}"  Command="{Binding FetchCommand}" />
                <MenuItem Header="{x:Static prop:Strings.Menu_Repository_Pull}"   Command="{Binding PullCommand}" />
                <MenuItem Header="{x:Static prop:Strings.Menu_Repository_Push}"   Command="{Binding PushCommand}" />
            </MenuItem>
            <MenuItem Header="{x:Static prop:Strings.Menu_Branch}">
                <MenuItem Header="{x:Static prop:Strings.Menu_Branch_Create}" Command="{Binding CreateBranchCommand}" />
                <Separator />
                <MenuItem Header="{x:Static prop:Strings.Menu_Branch_Stash}" Command="{Binding StashChangesCommand}" />
            </MenuItem>
            <MenuItem Header="{x:Static prop:Strings.Menu_Tag}">
                <MenuItem Header="{x:Static prop:Strings.Menu_Tag_Create}" Command="{Binding CreateTagCommand}" />
            </MenuItem>
            <MenuItem Header="{x:Static prop:Strings.Menu_Remote}">
                <MenuItem Header="{x:Static prop:Strings.Menu_Remote_Add}" Command="{Binding AddRemoteCommand}" />
                <Separator />
                <MenuItem Header="{x:Static prop:Strings.Menu_Remote_FetchAll}" Command="{Binding FetchCommand}" />
            </MenuItem>
            <MenuItem Header="_Commit"  IsEnabled="False" />
            <MenuItem Header="{x:Static prop:Strings.Menu_Tools}">
                <MenuItem Header="{x:Static prop:Strings.Menu_Tools_AccountSettings}" Command="{Binding OpenAccountSettingsCommand}" />
            </MenuItem>
            <MenuItem Header="{x:Static prop:Strings.Menu_Help}" IsEnabled="False" />
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" Background="{DynamicResource BrushSurface}">
            <ToolBar Background="{DynamicResource BrushSurface}">
                <Button Content="{x:Static prop:Strings.Toolbar_Open}"   Command="{Binding OpenRepositoryCommand}" ToolTip="{x:Static prop:Strings.Toolbar_Open_Tooltip}" />
                <Separator />
                <Button Content="{x:Static prop:Strings.Toolbar_Fetch}"  Command="{Binding FetchCommand}"          ToolTip="{x:Static prop:Strings.Toolbar_Fetch_Tooltip}" />
                <Button Content="{x:Static prop:Strings.Toolbar_Pull}"   Command="{Binding PullCommand}"           ToolTip="{x:Static prop:Strings.Toolbar_Pull_Tooltip}" />
                <Button Content="{x:Static prop:Strings.Toolbar_Push}"   Command="{Binding PushCommand}"           ToolTip="{x:Static prop:Strings.Toolbar_Push_Tooltip}" />
                <Separator />
                <Button Content="{x:Static prop:Strings.Toolbar_Branch}" Command="{Binding CreateBranchCommand}"  ToolTip="{x:Static prop:Strings.Toolbar_Branch_Tooltip}" />
                <Button Content="{x:Static prop:Strings.Toolbar_Stash}"  Command="{Binding StashChangesCommand}"  ToolTip="{x:Static prop:Strings.Toolbar_Stash_Tooltip}" />
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{DynamicResource BrushStatusBar}">
            <StatusBarItem>
                <ProgressBar Width="100" Height="10" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                             Margin="0,0,8,0" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource BrushOnStatusBar}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right" HorizontalContentAlignment="Right"
                           Visibility="{Binding UpdateAvailableText,
                               Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                <TextBlock Text="{Binding UpdateAvailableText}"
                           Foreground="#58a6ff"
                           FontWeight="SemiBold"
                           Cursor="Hand"
                           ToolTip="{x:Static prop:Strings.Update_BannerTooltip}"
                           MouseLeftButtonUp="OnUpdateBannerClick" />
            </StatusBarItem>
        </StatusBar>

        <!-- Main layout -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{Binding IsTerminalVisible, Converter={StaticResource BoolToRowHeightConverter}, ConverterParameter=200}" />
            </Grid.RowDefinitions>

            <!-- Sidebar + content + diff -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="150" MaxWidth="350" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="380" MinWidth="200" MaxWidth="600" />
                </Grid.ColumnDefinitions>

                <!-- Repository sidebar -->
                <Border Grid.Column="0"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="0,0,1,0">
                    <views:RepositorySidebarView DataContext="{Binding SidebarViewModel}" />
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              Background="{DynamicResource BrushBorder}" />

                <!-- Center: Dynamic tab system -->
                <TabControl Grid.Column="2"
                            ItemsSource="{Binding Tabs}"
                            SelectedItem="{Binding ActiveTab}"
                            Background="{DynamicResource BrushBackground}"
                            BorderThickness="0">
                    <TabControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TabDefinition}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Header}" VerticalAlignment="Center" FontSize="12" />
                                <Button Content="✕"
                                        Command="{Binding CloseCommand}"
                                        Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4,0,0,0"
                                        Margin="6,0,0,0"
                                        FontSize="10"
                                        Foreground="{DynamicResource BrushOnSurfaceMuted}"
                                        VerticalAlignment="Center"
                                        Cursor="Hand" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:TabDefinition}">
                            <ContentPresenter Content="{Binding ViewModel}" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                              Background="{DynamicResource BrushBorder}" />

                <!-- Right: Diff panel -->
                <Border Grid.Column="4"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1,0,0,0">
                    <views:DiffView DataContext="{Binding DiffViewModel}" />
                </Border>
            </Grid>

            <!-- Terminal splitter -->
            <GridSplitter Grid.Row="1" Height="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BrushBorder}"
                          Visibility="{Binding IsTerminalVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Terminal pane -->
            <views:TerminalPaneView Grid.Row="2"
                    DataContext="{Binding TerminalPaneViewModel}"
                    Visibility="{Binding IsTerminalVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

    </DockPanel>
</Window>
